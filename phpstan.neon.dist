parameters:
    level: 3
    paths:
        - src
    excludePaths:
        - src/ContaoManager
    bootstrapFiles:
        - vendor/autoload.php
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#^Access to an undefined property [\w\\]*(Model|Template|BackendUser)::\$#'
        - '#^Call to an undefined method [\w\\]*(Model|Collection)::#'
