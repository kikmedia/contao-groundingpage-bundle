{
    "name": "kikmedia/contao-groundingpage-bundle",
    "type": "contao-bundle",
    "description": "Grounding-Page Extension für Contao 5 & 6: Backend-Verwaltung und Frontend-Ausgabe von Referenzseiten nach dem Grounding Page Standard (groundingpage.com/spec), inkl. JSON-LD-Spiegelung, FAQ-Element, Backend-Berechtigungen und Sitemap-Integration.",
    "keywords": ["contao", "grounding page", "ai seo", "json-ld", "structured data", "schema.org"],
    "license": "LGPL-3.0-or-later",
    "homepage": "https://github.com/kikmedia/contao-groundingpage-bundle/",
    "authors": [
        {
            "name": "Carolina Koehn, kikmedia.webdevelopment",
            "email": "office@kikmedia.de"
        }
    ],
    "support": {
        "issues": "https://github.com/kikmedia/contao-groundingpage-bundle/issues",
        "source": "https://github.com/kikmedia/contao-groundingpage-bundle"
    },
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.3 || ^6.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.59",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Kikmedia\\GroundingPageBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kikmedia\\GroundingPageBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Kikmedia\\GroundingPageBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "minimum-stability": "stable"
}
