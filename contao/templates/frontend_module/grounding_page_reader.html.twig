{% extends "@Contao/frontend_module/_base.html.twig" %}
{% use "@Contao/component/_figure.html.twig" %}

{% block wrapper_tag %}article{% endblock %}

{% block attributes %}{{ attributes.addClass(archiveClass) }}{% endblock %}

{% block content %}
  <h1>{{ title }}</h1>

  {% if figure %}
    {{ block('figure_component') }}
  {% endif %}

  {% if definition %}
    <p><strong>{{ title }}</strong> {{ definition }}</p>
  {% endif %}
  {% if placement %}
    <p>{{ placement }}</p>
  {% endif %}
  {% if distinction %}
    <p>{{ distinction }}</p>
  {% endif %}

  {% if coreFacts %}
    <h2>{{ 'MSC.grounding_page_facts'|trans([title], 'contao_default') }}</h2>
    <dl>
      {% for fact in coreFacts %}
        {% if fact.label|default and fact.value|default('') != '' %}
          <dt>{{ fact.label }}</dt>
          <dd>{{ fact.value }}</dd>
        {% endif %}
      {% endfor %}
    </dl>
  {% endif %}

  {% if lastModified %}
    <dl>
      <dt>{{ 'MSC.grounding_page_modified'|trans({}, 'contao_default') }}</dt>
      <dd><time datetime="{{ lastModifiedIso }}">{{ lastModified }}</time></dd>
    </dl>
  {% endif %}

  {{ content|raw }}

  {% if relatedPages %}
    <p>
      {{ 'MSC.grounding_page_related'|trans({}, 'contao_default') }}
      {% for related in relatedPages %}{% if not loop.first %} · {% endif %}<a href="{{ related.href }}">{{ related.title }}</a>{% endfor %}
    </p>
  {% endif %}

  {% if sources %}
    <h2>{{ 'MSC.grounding_page_sources'|trans([title], 'contao_default') }}</h2>
    <ul>
      {% for source in sources %}
        {% if source.value|default %}
          <li><a href="{{ source.value }}" rel="noreferrer noopener" target="_blank">{{ source.label|default(source.value) }}</a></li>
        {% endif %}
      {% endfor %}
    </ul>
  {% endif %}

  {% if review %}
    <p>{{ 'MSC.grounding_page_review_notice'|trans([review.reviewer, review.date], 'contao_default') }}</p>
  {% endif %}

  {% if jsonLd %}
    <script type="application/ld+json">
{{ jsonLd|raw }}
    </script>
  {% endif %}

  {% if jsonLdFaq %}
    <script type="application/ld+json">
{{ jsonLdFaq|raw }}
    </script>
  {% endif %}
{% endblock %}
