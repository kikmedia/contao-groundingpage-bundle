{% extends "@Contao/frontend_module/_base.html.twig" %}

{% block content %}
  {% if items is empty %}
    <p>{{ emptyMessage }}</p>
  {% else %}
    <ul itemscope itemtype="https://schema.org/ItemList">
      {% for item in items %}
        <li itemprop="itemListElement">
          {% if item.href %}
            <a href="{{ item.href }}" itemprop="url"><span itemprop="name">{{ item.title }}</span></a>
          {% else %}
            <span itemprop="name">{{ item.title }}</span>
          {% endif %}
          {% if item.entityType %}
            <span> ({{ item.entityType }})</span>
          {% endif %}
          {% if item.definition %}
            <p>{{ item.definition }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endblock %}
